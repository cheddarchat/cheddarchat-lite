<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Plugin specific properties -->
  <PropertyGroup>
    <Product>CheddarChat Lite</Product>
    <Description>Accept paid messages and play them as donation alerts with text-to-speech in an OBS browser source overlay.</Description>
    <Authors>CheddarChat</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Plugin development properties -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- This will make sure that referencing BTCPayServer doesn't put any artifact in the published directory -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\btcpayserver\BTCPayServer.Client\BTCPayServer.Client.csproj" />
    <ProjectReference Include="..\btcpayserver\BTCPayServer.Abstractions\BTCPayServer.Abstractions.csproj" />
    <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

  <!--
    The plugin has no packages of its own. These are packages of BTCPay Server 2.4.2 with known vulnerabilities,
    raised to the first versions that fix them, so that the plugin is not built against the affected ones.
    Like everything else of BTCPay Server, they are not put into the plugin: a server runs its own versions.
    Remove a line once the btcpayserver submodule brings a fixed version itself.
  -->
  <ItemDefinitionGroup>
    <PackageReference>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- GHSA-334f-vvp4-7g6p, fixed in 10.0.13 -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.15" />
    <!-- GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx, fixed in 10.0.13 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- GHSA-vmv3-wvjp-wqpj, fixed in 10.0.15 -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    <!-- GHSA-mggc-4xg6-vcxf and GHSA-q939-rpr3-3284, fixed in 2026.0.0 -->
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>
</Project>
